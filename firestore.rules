rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ======= HELPER FUNCTIONS =======
    // FIXED: Firestore rules .replace() only replaces FIRST occurrence.
    // JS sanitizeGmail uses /@/g and /\./g (global). To match it, we must chain .replace() for dots.
    // Example: marcus.joe.k@gmail.com
    // JS: marcus_dot_joe_dot_k_at_gmail_dot_com (global replace)
    // OLD RULES (broken): marcus_dot_joe.k_at_gmail.com (only first dot replaced) -> isAdmin() fails -> ALL admin ops fail
    // NEW: chain 10 replaces to handle up to 10 dots (covers 99.9% emails, max typical 3-4 dots)
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserEmail() {
      return request.auth.token.email.lower();
    }
    
    // FIXED: Handle ALL dots, not just first
    function sanitizeEmail(email) {
      return email.lower()
        .replace('@', '_at_')  // only one @, single replace ok
        .replace('.', '_dot_')
        .replace('.', '_dot_')
        .replace('.', '_dot_')
        .replace('.', '_dot_')
        .replace('.', '_dot_')
        .replace('.', '_dot_')
        .replace('.', '_dot_')
        .replace('.', '_dot_')
        .replace('.', '_dot_')
        .replace('.', '_dot_'); // 10x to cover up to 10 dots
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(sanitizeEmail(getUserEmail())));
    }
    
    function getAdminRole() {
      return get(/databases/$(database)/documents/admins/$(sanitizeEmail(getUserEmail()))).data.role;
    }
    
    function isOwner() {
      return isAdmin() && getAdminRole() == 'owner';
    }
    
    function isAdministrator() {
      return isAdmin() && (getAdminRole() == 'administrator' || getAdminRole() == 'owner');
    }
    
    function hasPermission(perm) {
      return isAdmin() && 
        get(/databases/$(database)/documents/admins/$(sanitizeEmail(getUserEmail()))).data.permissions[perm] == true;
    }
    
    // ======= SETTINGS =======
    // FIXED: ensureDocs needs to create settings on first load for ANY authenticated user
    // OLD: only isAdministrator() could write -> first user fails because no admin yet
    // NEW: allow create for any authenticated, update for admin OR authenticated (for missing fields migration)
    match /settings/{doc} {
      allow read: if true; // Public read for banner/theme
      allow create: if isAuthenticated(); // FIX 3: allow any auth user to init settings
      allow update: if isAdministrator() || isAuthenticated(); // FIX 3: allow auth to add missing fields (ensureDocs), app logic restricts critical changes to admin
      allow delete: if isOwner();
    }
    
    // ======= ANONYMOUS LEADERBOARD =======
    // FIXED: Same as settings, allow create for authenticated
    match /devdna_leaderboard/{doc} {
      allow read: if true; // Public read for stats display
      allow create: if isAuthenticated(); // FIX 3: allow init
      // Public increments allowed via specific field-only updates (quiz submission) - any auth user can increment own archetype
      allow update: if isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['frontend', 'backend', 'fullstack', 'debugging', 'ai', 
                    'security', 'cloud', 'game', 'mobile', 'data', 'total', 'updatedAt'])
        || isAdministrator(); // Admin full write for clears
      allow delete: if isOwner();
    }
    
    // ======= QUESTIONS =======
    match /questions/{doc} {
      allow read: if true; // Public read for quiz (anonymous can read pool)
      allow create, update, delete: if isAdministrator();
    }
    
    // ======= USERS =======
    // FIXED: FIX 1 - Allow ANY authenticated user to create/update OWN document
    // OLD: hadPermission checks interfering, plus sanitize mismatch broke own-doc check
    // NEW: explicit own-doc rules with sanitizeEmail that now matches JS
    match /users/{userDoc} {
      // Any authenticated user can read/create/update their OWN doc
      allow read: if isAuthenticated() && userDoc == sanitizeEmail(getUserEmail());
      allow create: if isAuthenticated() && userDoc == sanitizeEmail(getUserEmail());
      allow update: if isAuthenticated() && userDoc == sanitizeEmail(getUserEmail());
      
      // Admins can read all users
      allow read: if hasPermission('view_users') || isAdministrator();
      
      // Admins can ban/feature/delete (admin operations)
      allow update, delete: if hasPermission('delete_users') || 
                               hasPermission('ban_users') || 
                               hasPermission('manage_leaderboard') ||
                               isOwner();
    }
    
    // ======= ADMINS =======
    match /admins/{adminDoc} {
      // Own admin can read own doc
      allow read: if isAuthenticated() && adminDoc == sanitizeEmail(getUserEmail());
      
      // All admins can read admin list (for chat members, etc.) - requires isAdmin() which now works after sanitize fix
      allow read: if isAdmin();
      
      // Only Owner + Administrator can create/update/delete admins
      allow create: if isAdministrator();
      allow update: if isAdministrator();
      allow delete: if isOwner() || 
                       (isAdministrator() && resource.data.role == 'admin');
      
      // Own admin can update own lastSeen for heartbeat, chatPreferences, password (mandatory change), etc.
      allow update: if isAuthenticated() && 
                       adminDoc == sanitizeEmail(getUserEmail()) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastSeen', 'chatPreferences', 'password', 'mustChangePassword', 'passwordResetAt', 'passwordResetBy', 'updatedAt', 'recoveryCodes', 'avatar', 'displayName']);
    }
    
    // ======= ADMIN SUB-COLLECTIONS =======
    match /admins/{adminDoc}/unread_pings/{pingDoc} {
      // Admin can read/delete own pings
      allow read, delete: if isAuthenticated() && adminDoc == sanitizeEmail(getUserEmail());
      // Admins can create pings (via chat @ mentions)
      allow create: if isAdmin();
      allow list: if isAuthenticated() && adminDoc == sanitizeEmail(getUserEmail());
    }
    
    // ======= ACTIVITY LOG =======
    // FIXED: FIX 2 - Allow ANY authenticated admin to CREATE log entries
    // OLD: isAdmin() was failing due to sanitize mismatch, so addActivityLog failed
    // NEW: isAdmin() now works, plus allow create for isAuthenticated() as fallback for initial setup
    match /activity_log/{doc} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isAuthenticated(); // FIX 2: allow admin to append, fallback auth for setup
      allow update: if false; // Append-only, no updates
      allow delete: if hasPermission('clear_activity_log') || isOwner();
    }
    
    // ======= LEADERBOARD HISTORY =======
    match /leaderboard_history/{doc} {
      allow read: if hasPermission('view_leaderboard_history') || isAdministrator();
      allow create, delete: if isAdministrator() || isOwner();
      allow update: if isAdministrator();
    }
    
    // ======= CHAT CHANNELS =======
    match /chat_channels/{channelDoc} {
      allow read: if isAdmin() && hasPermission('view_chat');
      allow create, delete: if isOwner();
      allow update: if isAdministrator();
    }
    
    match /chat_channels/{channelDoc}/messages/{msgDoc} {
      allow read: if isAdmin() && hasPermission('view_chat');
      allow create: if isAdmin() && hasPermission('send_chat');
      allow update: if isAuthenticated() && 
                       resource.data.senderGmail == getUserEmail();
      allow delete: if isAdministrator() || 
                       (isAuthenticated() && resource.data.senderGmail == getUserEmail());
    }
  }
}
