rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ======= HELPER FUNCTIONS =======
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserEmail() {
      return request.auth.token.email.lower();
    }
    
    function adminListExists() {
      return exists(/databases/$(database)/documents/settings/admin_list);
    }
    
    function getAdminList() {
      return get(/databases/$(database)/documents/settings/admin_list).data;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
             adminListExists() &&
             getUserEmail() in getAdminList().emails;
    }
    
    function isOwner() {
      return isAdmin() &&
             getAdminList().ownerEmail == getUserEmail();
    }
    
    function isAdministrator() {
      return isAdmin() && (
        isOwner() ||
        getUserEmail() in getAdminList().administratorEmails
      );
    }
    
    // ======= admin_list itself =======
    // Public read needed because rules use get() on it 
    // (get() bypasses read rules but list content should 
    // still be readable for admin panel). Only owner + 
    // administrators can modify.
    match /settings/admin_list {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdministrator();
      allow delete: if isOwner();
    }
    
    // ======= /settings/ (other docs) =======
    match /settings/{doc} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdministrator() || isAuthenticated();
      allow delete: if isOwner();
    }
    
    // ======= ANONYMOUS LEADERBOARD =======
    match /devdna_leaderboard/{doc} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isOwner();
    }
    
    // ======= QUESTIONS =======
    match /questions/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdministrator();
    }
    
    // ======= USERS =======
    match /users/{userDoc} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdministrator() || 
                       (isAuthenticated() && 
                        request.auth.uid == resource.data.uid);
    }
    
    // ======= ADMINS =======
    match /admins/{adminDoc} {
      allow read: if isAdmin();
      allow create: if isAdministrator();
      allow update: if isAdministrator() || 
                       (isAuthenticated() && 
                        resource.data.gmail.lower() == getUserEmail());
      allow delete: if isOwner() || 
                       (isAdministrator() && resource.data.role == 'admin');
    }
    
    // ======= ADMIN SUB-COLLECTIONS =======
    match /admins/{adminDoc}/unread_pings/{pingDoc} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin();
      allow list: if isAdmin();
    }
    
    // ======= ACTIVITY LOG =======
    match /activity_log/{doc} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isOwner() || isAdministrator();
    }
    
    // ======= LEADERBOARD HISTORY =======
    match /leaderboard_history/{doc} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdministrator();
    }
    
    // ======= CHAT CHANNELS =======
    match /chat_channels/{channelDoc} {
      allow read: if isAdmin();
      allow create, delete: if isOwner();
      allow update: if isAdministrator();
    }
    
    match /chat_channels/{channelDoc}/messages/{msgDoc} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAuthenticated() && 
                       resource.data.senderGmail == getUserEmail();
      allow delete: if isAdministrator() || 
                       (isAuthenticated() && 
                        resource.data.senderGmail == getUserEmail());
    }
  }
}
